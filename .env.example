# Optional: only needed if you want the dashboard's Send button to send via SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Your Name <your.email@gmail.com>"
SMTP_USE_TLS=true

# Optional: enables AI-generated variants. Without this, the app uses safe German templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1


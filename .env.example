# Optional: only needed if you want the dashboard's Send button to send via SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Your Name <your.email@gmail.com>"
SMTP_USE_TLS=true

# Optional: enables AI-generated variants. Without this, the app uses safe German templates.
# DeepSeek is OpenAI-compatible. Current official defaults as of 2026-07-03:
# base URL https://api.deepseek.com and model deepseek-v4-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional generic OpenAI-compatible fallback.
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
